{
  "name": "@comchatx/cx-board",
  "version": "0.3.12",
  "description": "Keeps cx's reports and drafts on a board beside the chat.",
  "license": "MIT",
  "author": "ComChatX",
  "homepage": "https://github.com/comchatx/cx-board#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-board.git"
  },
  "bugs": "https://github.com/comchatx/cx-board/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "skills",
    "kit",
    "viewers",
    "!viewers/src",
    "README.zh-CN.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "viewers": "node scripts/viewers.mjs"
  },
  "comchatx": {
    "name": "Flex Board",
    "nameZh": "灵动看板",
    "about": "cx 的报告和草稿放上看板，不会淹没在对话里。",
    "mark": {
      "on": "board",
      "draw": [
        {
          "d": "M6.6 6.1h3.1a1 1 0 0 1 1 1v3a1 1 0 0 1 -1 1h-3.1a1 1 0 0 1 -1 -1v-3a1 1 0 0 1 1 -1zM6.6 12.9h3.1a1 1 0 0 1 1 1v3a1 1 0 0 1 -1 1h-3.1a1 1 0 0 1 -1 -1v-3a1 1 0 0 1 1 -1zM14.3 6.1h3.1a1 1 0 0 1 1 1v5.7a1 1 0 0 1 -1 1h-3.1a1 1 0 0 1 -1 -1v-5.7a1 1 0 0 1 1 -1z",
          "cut": true
        }
      ]
    },
    "section": "extensions",
    "order": 110,
    "skills": {
      "cx-board": {
        "about": {
          "en": "Tells cx where the board is and what an entry holds.",
          "zh": "告诉 cx 看板在哪里、每一条写什么。"
        }
      }
    },
    "viewers": [
      {
        "files": [
          "md",
          "markdown"
        ],
        "page": "viewers/markdown.html"
      },
      {
        "files": [
          "csv",
          "tsv"
        ],
        "page": "viewers/table.html"
      },
      {
        "files": [
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp"
        ],
        "page": "viewers/picture.html",
        "bytes": true
      },
      {
        "files": [
          "docx"
        ],
        "page": "viewers/word.html",
        "bytes": true
      }
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "26.2.0",
    "happy-dom": "21.0.4",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-codemode": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "@earendil-works/pi-telemetry": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2"
  }
}
